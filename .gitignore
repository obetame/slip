# Frontend build tooling. node_modules and the npm cache live inside the repo
# so nothing is written outside it. tooling/package-lock.json IS committed, so
# installs stay reproducible; do not add it here.
/tooling/node_modules/
/.npmcache/

# Scratch directory used by tooling/build.mjs for the tsc ES5 emit. The bundles
# it produces are committed under internal/web/static/.
/.webuild/

# internal/web/static/*.js are generated by `npm run build` in tooling/ and are
# intentionally tracked, so there is deliberately no rule ignoring them.
/.webuild2/
