{
  "name": "slip-web-tooling",
  "version": "0.1.0",
  "private": true,
  "description": "Build tooling for the slip browser client. tsc downlevels TypeScript to ES5, then esbuild bundles it.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && node build.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
